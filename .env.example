# Copy this file to .env. Do not put production secrets in .env.example.
# Blank values disable the optional integration.

# Local Docker Postgres only. These passwords are not for a hosted Supabase database.
# Application role. Use the migration URL for npm run db:migrate.
DATABASE_URL=postgres://cognera_app:cognera_local_app@localhost:5433/cognera
DATABASE_MIGRATION_URL=postgres://cognera_admin:cognera_local_admin@localhost:5433/cognera

# Shown in the footer and on the home page. Leave SUPPORT_EMAIL blank until you have one.
PUBLIC_SITE_URL=http://localhost:3000
SUPPORT_EMAIL=

# Optional. Sign-in stays disabled until both are set. Never put the service-role key in a NEXT_PUBLIC variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Public contact messages are saved as leads in this organization. Leave blank to refuse them.
CONTACT_ORGANIZATION_ID=

# Optional. Public pages, posts, sitemap, and public images are read from this organization only.
PUBLIC_CONTENT_ORGANIZATION_ID=

# Optional media store. Leave MEDIA_STORAGE unset to keep files on local disk under storage/media.
# MEDIA_STORAGE=s3
# MEDIA_STORAGE_DIR=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# Local AI (Ollama). No paid API or key is needed. Leave blank to keep AI features off;
# the rest of Cognera works either way. Run `npm run ai:check` for a model suggestion.
# Typical local value: http://127.0.0.1:11434
OLLAMA_BASE_URL=
# OLLAMA_MODEL=llama3.2
# Per-request timeout in milliseconds (5000 to 300000). Larger models on CPU need more.
# AI_TIMEOUT_MS=90000

# Optional. Workflow email nodes send JSON to this public HTTPS URL. Leave blank and those steps fail without sending.
# The address is checked for SSRF, so a private or loopback URL is rejected.
# In local dev there is no public URL for your own machine, so this app ships a relay at
# /api/email-relay that forwards to Resend's free tier. Expose it with a tunnel, e.g.:
#   cloudflared tunnel --url http://localhost:3000
# then set EMAIL_WEBHOOK_URL to https://<tunnel-subdomain>.trycloudflare.com/api/email-relay
# EMAIL_WEBHOOK_URL=

# Required by /api/email-relay. Sign up free at https://resend.com (no credit card, 100
# emails/day). Without a verified domain, RESEND_FROM_EMAIL must stay onboarding@resend.dev
# and mail can only be sent to the email address your Resend account was created with.
# EMAIL_RELAY_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Workflow execution is enabled by the workflow_runtime row. Turning it off is a database change, not an environment variable.
# Run due work with: npm run workflows:work

# Required for /api/cron/workflows, the production stand-in for `npm run workflows:work`
# on hosts without a persistent worker. Point a free scheduler (e.g. cron-job.org) at
# POST https://<your-domain>/api/cron/workflows every few minutes with header
# x-cron-secret: <this value>. Leave blank to disable the route.
# WORKFLOW_CRON_SECRET=
